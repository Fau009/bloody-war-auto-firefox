{
  "manifest_version": 3,
  "name": "Bloody War Auto",
  "version": "0.1.0",
  "description": "Automação de ataques (Criaturas e Batalhas) para The Bloody War.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://www.thebloodywar.com/*"],
  "background": {
    "scripts": ["shared.js", "background.js"]
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bloody War Auto",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.thebloodywar.com/*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "bloody-war-auto@fabio.local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
